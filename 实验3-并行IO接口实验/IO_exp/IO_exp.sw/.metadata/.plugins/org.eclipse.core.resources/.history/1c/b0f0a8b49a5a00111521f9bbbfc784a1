#include <stdio.h>
#include "xgpio.h"

int main() {
    Xil_Out16(XPAR_AXI_GPIO_0_BASEADDR+XGPIO_TRI_OFFSET, 0xffff);   //配置GPIO0 ch1(开关)为输入
    Xil_Out16(XPAR_AXI_GPIO_0_BASEADDR+XGPIO_TRI2_OFFSET, 0x0000);  //配置GPIO0 ch2(LED)为输出
    Xil_Out16(XPAR_AXI_GPIO_1_BASEADDR+XGPIO_TRI_OFFSET, 0x0);  //配置GPIO1 ch1数码管段选信号为输出
    Xil_Out16(XPAR_AXI_GPIO_1_BASEADDR+XGPIO_TRI2_OFFSET, 0x0);  //配置GPIO1 ch2数码管位选信号为输出
    Xil_Out8(XPAR_AXI_GPIO_2_BASEADDR+XGPIO_TRI_OFFSET, 0x1f);  //按键gpio输入 控制低五位

    char segcode[6] = {0x00,0xc6,0xc1,0xc7,0xa1,0xef};   //c,u,l,d,r
    short pos = 0xff7f;  //数码管位选信号
    int button = 0;  //按键状态
    while(1) {
        u16 sw = Xil_In16(XPAR_AXI_GPIO_0_BASEADDR+XGPIO_DATA_OFFSET);  //读取开关状态
        Xil_Out16(XPAR_AXI_GPIO_0_BASEADDR+XGPIO_DATA2_OFFSET, sw);   //将开关状态输出到LED
        // 按键按下时改变button的值，控制数码管显示不同的字符
        u8 button_state = Xil_In8((XPAR_AXI_GPIO_2_BASEADDR+XGPIO_DATA_OFFSET)&0x1f);
        printf("%d\n", button_state);
        switch (Xil_In8((XPAR_AXI_GPIO_2_BASEADDR+XGPIO_DATA_OFFSET)&0x1f))
        {
        case 0b10000:
            button = 1;
            break;
        case 0b01000:
            button = 2;
            break;
        case 0b00100:
            button = 3;
            break;
        case 0b00010:
            button = 4;
            break;
        case 0b00001:
            button = 5;
            break;
        default:
            button = 0;
            break;
        }
        for(int i=0; i<8; i++) {
            Xil_Out16(XPAR_AXI_GPIO_1_BASEADDR+XGPIO_DATA2_OFFSET, segcode[button]);  //根据开关状态输出数码管段选信号
            Xil_Out16(XPAR_AXI_GPIO_1_BASEADDR+XGPIO_DATA_OFFSET, pos);  //输出数码管位选信号
            for(int j=0; j<10000; j++);  //延时
            pos = pos >> 1;  //位选信号循环右移
        }
        pos = 0xff7f;  //重置位选信号
    }
}
